{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd webapp && npm install",
  "buildCommand": "cd webapp && npm run build",
  "outputDirectory": "webapp/dist",
  "rewrites": [
    {
      "source": "/((?!data/|assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/meta.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
